# Application Environment
NODE_ENV=development
PORT=8000
# Admin dashboard origin (CORS allowlist)
APP_URL=http://localhost:3000
# Public attendance form origin (CORS allowlist). Omit if the form is served
# from APP_URL. Comma-separate to allow more than one.
ATTENDANCE_FORM_URL=http://localhost:3001
# Number of reverse proxies in front of the API, as an integer. Controls which
# X-Forwarded-For entry is trusted as the client IP for rate limiting.
# Leave unset when there is no proxy. NEVER set this to `true`: the leftmost
# header entry is then attacker-controlled and every rate limit is bypassable.
TRUST_PROXY_HOPS=

# Database Configuration (PostgreSQL Docker & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DiscordMgr_2026
POSTGRES_DB=discord_manager
POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:DiscordMgr_2026@localhost:5433/discord_manager?schema=public"

# Security / Hashing
BCRYPT_SALT_ROUNDS=9

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Initial Admin Seeding (Single email or comma-separated list)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_EMAILS="admin1@example.com,admin2@example.com"
ADMIN_PASSWORD="adminPassword123"

# Discord Bot
#
# Two PRIVILEGED intents must be enabled in the Discord Developer Portal under
# Bot -> Privileged Gateway Intents. Discord refuses the whole connection when a
# requested privileged intent is off, so these are not optional:
#   - Server Members Intent  -> the member directory the attendance form checks
#   - Message Content Intent -> reading #daily-update posts
# Without Message Content the bot still starts (it retries without that intent)
# but daily-update ingestion is OFF; GET /api/discord/sync/status reports it.
#
# CHANNEL PERMISSION: the bot also needs "Manage Roles" on the #daily-update
# channel, so it can edit the @everyone SendMessages overwrite when the schedule
# opens and locks the channel. Without it every open and lock is rejected with
# DiscordAPIError[50013] and the submission window is never enforced — the only
# symptoms are a channel that never opens and an error on
# GET /api/schedule/daily-update. This is a channel permission, not a portal
# toggle: grant it on the channel or on a role the bot holds.
#
# CHANNEL PERMISSION: the bot also needs "Send Messages" on the
# #daily-update-reminder channel (REMINDER_CHANNEL_ID), for the fallback that
# mentions members whose DMs are closed. Without it the reminder DMs still go
# out and the fallback silently reaches NOBODY — the members who most need the
# reminder are exactly the ones it fails for, and nothing looks wrong. Reported
# on GET /api/reminders/status; check it there first.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=000000000000000000
ATTENDANCE_CHANNEL_ID=000000000000000000
DAILY_UPDATE_CHANNEL_ID=000000000000000000
REMINDER_CHANNEL_ID=000000000000000000

# Channel Scheduler
#
# Whether THIS process runs the timed open/lock jobs for #daily-update.
# The schedule itself (times, weekdays, on/off) is stored in the database and
# edited from the admin dashboard — it is NOT configured here.
#
# node-cron runs in-process, so every replica with this on fires its own jobs:
# the permission edit is idempotent, but each replica also posts its own
# announcement embed to a channel thousands of students read. Set this to true
# on exactly ONE instance and false on the rest.
#
# Unset means true, which is correct for a single-instance deployment. Only an
# explicit `false` (or `0`) disables it. Disabling affects the timed jobs and
# the boot reconcile only: POST /api/schedule/daily-update/open and /lock, and
# the status read, keep working on every instance.
SCHEDULER_ENABLED=true

# Redis (BullMQ reminder DM queue)
#
# Backing store for the reminder queue and NOTHING else. It is deliberately not
# a dependency of the API, the Discord bot, ingestion, or the channel scheduler:
# with Redis down everything else serves normally and only reminder broadcasts
# are refused (503, naming Redis). REDIS_PORT is read by docker-compose.yml.
#
# Note that the public attendance rate limiters still use their in-memory store
# and were deliberately NOT moved onto Redis. A Redis outage that stalls
# reminders is an inconvenience; the same outage on the path ~5,000 students
# submit through is not. See src/middlewares/rateLimit.ts.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Reminder DM Queue
#
# Whether THIS process consumes reminder DM jobs. Unlike SCHEDULER_ENABLED this
# is not a correctness requirement: the queue's rate limiter counts in Redis and
# is shared across every worker, so two workers still deliver within ONE DM
# budget. It is here for operational control (draining a node, or moving the
# worker to its own process later).
#
# Unset means true. Only an explicit `false` (or `0`) disables it, and it gates
# job consumption only — POST /api/reminders/send, the progress reads, and
# cancel keep working on every instance.
REMINDER_WORKER_ENABLED=true

# DMs per second the worker is allowed to send. Golden Rule 4: never burst.
# Discord rate limits, then bans, a bot that DMs thousands of people quickly —
# and because the bot shares this process, that ban also stops member sync and
# with it the attendance form's membership check.
#
# Clamped to 1-5, and anything missing, non-numeric, or outside that range falls
# back to 2. At 2/sec a 5,000-member broadcast takes roughly 40 minutes; that is
# the intended trade, not a problem to tune away.
REMINDER_DM_PER_SECOND=2
