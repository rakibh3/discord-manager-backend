{
  "info": {
    "name": "Discord Daily Attendance & Update Automation API",
    "description": "API collection for the Discord Daily Attendance & Update Automation backend.\n\n## Authentication Model\n- **Admin Only**: System login and dashboard access is permitted exclusively for administrators.\n- **Direct Attendance**: Regular users/students do not log in or register; they submit daily attendance directly via the public web attendance form.\n\n## Auto Token Management\nThe Admin Login request automatically saves the access token as a collection variable. All authenticated requests use it via the collection-level pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-inject Authorization header for every request",
          "const token = pm.collectionVariables.get('accessToken');",
          "if (token) {",
          "    pm.request.headers.upsert({",
          "        key: 'Authorization',",
          "        value: token",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Admin authentication endpoints. Login auto-saves the token for all other requests.",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"adminPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Auto-save tokens so you never have to copy-paste",
                  "const jsonData = pm.response.json();",
                  "",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    console.log('✅ accessToken saved to collection variables');",
                  "}",
                  "",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    console.log('✅ refreshToken saved to collection variables');",
                  "}",
                  "",
                  "// Basic assertions",
                  "pm.test('Admin Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Uses the refreshToken cookie (set automatically by the Login response) to get a new accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    console.log('✅ accessToken refreshed and saved');",
                  "}",
                  "",
                  "pm.test('Token refreshed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Invalidates the refresh token and clears auth cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');",
                  "pm.test('Logout successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Profile",
      "description": "Admin profile management endpoints (requires ADMIN role).",
      "item": [
        {
          "name": "Get Admin Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me",
            "description": "Requires admin auth. Returns the logged-in admin's profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin profile retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Admin Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/my-profile",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Admin User\",\n    \"profilePhoto\": \"https://example.com/admin.jpg\",\n    \"bio\": \"System Administrator\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires admin auth. Updates the logged-in admin's profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin profile updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Discord",
      "description": "Discord bot & guild member sync endpoints (requires ADMIN role).",
      "item": [
        {
          "name": "Get Sync Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/discord/sync/status",
            "description": "Requires admin auth. Returns bot connection state, stored member counts (total / active / departed), and the last sync summary."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('Sync status retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.bot).to.have.property('connected');",
                  "    pm.expect(jsonData.data.members).to.have.property('active');",
                  "});",
                  "",
                  "// The departure guard trips when a member fetch looks truncated,",
                  "// which almost always means the Server Members privileged intent is off.",
                  "if (jsonData.data && jsonData.data.lastSync && jsonData.data.lastSync.guardTripped) {",
                  "    console.warn('⚠️ Departure guard tripped - check the Server Members intent in the Discord Developer Portal');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Trigger Member Sync",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/discord/sync",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires admin auth. Starts a full guild member re-sync and returns immediately with 202 Accepted; the sync itself runs in the background. Returns 409 if a sync is already running, or 503 if the bot is not connected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Member sync accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
