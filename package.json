    "start:dev": "tsx watch src/server.ts",
    "lint": "eslint src prisma",
    "lint:fix": "eslint src prisma --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
