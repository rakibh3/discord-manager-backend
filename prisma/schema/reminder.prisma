// Reminder broadcasts: one session row per admin-triggered run, one recipient
// row per targeted member holding that member's individual delivery outcome.
//
// The recipient rows are the source of truth; `sentCount` / `failedCount` on
// the session are an incrementing cache so the SSE progress bar can read one
// small row instead of aggregating recipients on every poll.

enum ReminderStatus {
  PENDING
  PROCESSING
  COMPLETED
  // A broadcast an admin deliberately stopped. Kept distinct from FAILED
  // because the two demand opposite responses: CANCELLED is a decision and
  // needs nothing, FAILED is a fault to investigate. Collapsing them would
  // bury a stalled worker among the runs somebody meant to stop.
  CANCELLED
  FAILED
}

// Which rule decided that an account owed a reminder.
//
// Stored on the run rather than assumed, because the two produce different
// recipient lists from the same data and an audit that cannot say which one
// applied cannot explain why somebody was contacted.
enum ReminderCriterion {
  // No daily update recorded that day, whatever attendance says. The default,
  // and exactly what a broadcast meant before ranges existed.
  MISSING_UPDATE
  // Neither an attendance submission nor a daily update that day.
  MISSING_BOTH
}

enum ReminderDeliveryStatus {
  // A recipient row exists from the moment the broadcast is queued; it only
  // reaches a terminal state when its job actually runs.
  //
  // Recipients left PENDING after a cancellation are CORRECT and must stay that
  // way: they were never attempted, and rewriting them to FAILED would claim a
  // delivery was tried when nothing was sent. `finalizeReminderLog` therefore
  // only counts them — it never updates them — and a cancelled session reports
  // "N never attempted" rather than "N failed".
  PENDING
  DELIVERED
  DM_CLOSED // Discord error 50007 — the fallback channel mention targets these
  FAILED
}

// One broadcast session.
model ReminderLog {
  id String @id @default(uuid())

  // The period this broadcast covered, inclusive at both ends. A single-date
  // broadcast stores the same date twice.
  //
  // There is deliberately no third `reminder_date` column holding "the" date:
  // a value derivable from these two is a copy that can disagree with them,
  // the same rule that keeps a second `guild_id` off the child tables.
  //
  // `String` for the reason every civil date in this domain is a string — a
  // timezone-carrying value can be shifted by a driver onto the wrong day.
  // They compare and range-scan correctly as strings, which is what makes the
  // overlap check a plain pair of string comparisons.
  reminderStartDate String @map("reminder_start_date") // YYYY-MM-DD, Asia/Dhaka
  reminderEndDate   String @map("reminder_end_date") // YYYY-MM-DD, Asia/Dhaka

  // The criteria that produced the recipient list. Recomputing "who would this
  // have targeted" from current data gives a different answer as members join
  // and leave, so the rule is recorded rather than inferred.
  criterion     ReminderCriterion @default(MISSING_UPDATE)
  minMissedDays Int               @default(1) @map("min_missed_days")

  // Which weekdays inside the period counted, in cron's 0-is-Sunday numbering.
  //
  // EMPTY means every day in the period counted — deliberately the opposite of
  // `ChannelSchedule.daysOfWeek`, which rejects an empty array because
  // `enabled: false` is its pause switch. There is no second switch here, and
  // no ambiguity: a run that counted no days could not have existed.
  daysOfWeek Int[] @default([]) @map("days_of_week")

  message String @db.Text

  targetCount Int            @map("target_count")
  sentCount   Int            @default(0) @map("sent_count")
  failedCount Int            @default(0) @map("failed_count")
  status      ReminderStatus @default(PENDING)

  // The admin who triggered it. Nullable with SetNull: deleting a retired
  // admin account must not delete the audit trail of broadcasts they sent.
  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipients ReminderRecipient[]

  // The overlap guard's lookup: unfinished runs covering a proposed period.
  @@index([reminderStartDate, reminderEndDate])
  @@map("reminder_logs")
}

// One targeted member's outcome within a broadcast.
model ReminderRecipient {
  id String @id @default(uuid())

  reminderId String      @map("reminder_id")
  reminder   ReminderLog @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  memberId String        @map("member_id")
  member   DiscordMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status       ReminderDeliveryStatus @default(PENDING)
  errorMessage String?                @map("error_message")
  sentAt       DateTime?              @map("sent_at")
  createdAt    DateTime               @default(now()) @map("created_at")

  // Golden Rule 7 / Golden Rule 4: a retried queue job must not be able to DM
  // the same member twice within one broadcast.
  @@unique([reminderId, memberId])
  // Live progress counts and the closed-DM fallback list.
  @@index([reminderId, status])
  @@map("reminder_recipients")
}
