// Enum

enum UserRole {
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

// User

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  password     String
  role         UserRole   @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  profile       Profile?
  refreshTokens RefreshToken[]
  // Broadcasts this admin triggered. Author only — an admin is never the
  // subject of an attendance or daily-update record.
  reminderLogs  ReminderLog[]
  // Channel schedules this admin last edited. Audit only, and nullable on the
  // other side: deleting the account must not take the schedule with it.
  channelSchedules ChannelSchedule[]
  // The announcement template this admin last edited, and the manual sends they
  // triggered. Audit only, nullable on the other side for the same reason — the
  // message the program posts every evening must outlive the account.
  announcementTemplates AnnouncementTemplate[]
  announcementLogs      AnnouncementLog[]
  // Roster spreadsheets this admin uploaded, and the enforcement setting they
  // last changed. Audit only, nullable on the other side for the same reason:
  // the record of who changed who may submit must outlive the account.
  rosterImports  RosterImport[]
  rosterSettings RosterSetting[]

  @@map("users")
}

// Refresh Token

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}